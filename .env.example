# Backend env (NexusFocus/.env)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXUS_JWT_SECRET=change-me-with-a-long-random-string
NEXUS_JWT_EXPIRES_MINUTES=1440

# --- Kurumsal rapor e-postasi (POST /tenants/me/report-email) ---
# Oncelik: NEXUSFOCUS_RESEND_API_KEY doluysa Resend HTTPS API kullanilir; degilse SMTP.

# Secenek A — Resend (onerilen, SMTP sunucusu gerekmez): https://resend.com/api-keys
# Gonderen: Resend panelinde dogrulanmis alan veya test icin "NexusFocus <onboarding@resend.dev>"
NEXUSFOCUS_RESEND_API_KEY=
NEXUSFOCUS_MAIL_FROM=NexusFocus <onboarding@resend.dev>

# Secenek B — SMTP (Gmail: uygulama sifresi; normal hesap sifresi calismaz)
# Alternatif isimler: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, MAIL_FROM
NEXUSFOCUS_SMTP_HOST=
NEXUSFOCUS_SMTP_PORT=587
NEXUSFOCUS_SMTP_USER=
NEXUSFOCUS_SMTP_PASSWORD=
NEXUSFOCUS_SMTP_FROM=
NEXUSFOCUS_SMTP_USE_TLS=true

# CORS izinli origin'ler (virgulle ayirin)
NEXUS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
